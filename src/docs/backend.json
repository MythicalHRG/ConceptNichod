
{
  "entities": {
    "Topic": {
      "title": "Topic",
      "description": "Represents a learning topic.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the topic." },
        "name": { "type": "string", "description": "The name of the topic." },
        "summary": { "type": "string", "description": "The AI-generated summary of the topic." },
        "questions": {
          "type": "array",
          "description": "An array of AI-generated questions for the topic.",
          "items": { "$ref": "#/entities/Question" }
        },
        "createdAt": { "type": "string", "description": "Timestamp indicating when the topic was created.", "format": "date-time" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Question": {
      "title": "Question",
      "description": "Represents a single question related to a topic.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "The category of the question (e.g., understanding, creativity)." },
        "question": { "type": "string", "description": "The text of the question." }
      },
      "required": ["type", "question"]
    }
  },
  "firestore": {
    "/topics/{topicId}": {
      "schema": { "$ref": "#/entities/Topic" },
      "description": "Stores the learning topics."
    }
  }
}
